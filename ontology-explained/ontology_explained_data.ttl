		:Source-9a8cc7a7-e840-5b19-a824-45727da4998a ,	# Designing and Building Enterprise Knowledge Graphs
		:Source-01ef49c1-8236-57bb-bbab-420511153ad0 ,	# Protégé
		:Source-7f95b358-abbe-5233-b39d-79d0fecc9b74 ,	# New Protégé Pizza Tutorial (Michael DeBellis)
