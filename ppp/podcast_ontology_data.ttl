#### Episode 7
:PPP-Episode7 a :PodcastEpisode ;
	:name "Computer Minds, Mike Levin & Panpsychism" ;
	:hasDuration [:duration "PT1H43M14S"^^xsd:duration] ;
	:episodeNumber "7"^^xsd:decimal ;
	:releaseDate [:universalDate "2026-08-20"^^xsd:date] ;
