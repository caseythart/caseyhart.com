:PPP-Episode1 a :PodcastEpisode ;
	      :name "Artificial General Intelligence? Wanna Bet?" ;
	      :hasDuration [:duration "PT48M38S"^^xsd:duration] ;
	      :episodeNumber "1"^^xsd:decimal ;
	      :releaseDate [:universalDate "2026-07-09"^^xsd:date ] ;
